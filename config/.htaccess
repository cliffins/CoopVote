# Database credentials and the Gmail App Password live here. PHP normally
# executes these files rather than showing them, but a misconfigured or
# disabled PHP handler would serve them as plain text — deny outright.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    # Apache 2.2 syntax — using 2.4 syntax on 2.2 is a fatal error that
    # takes the whole site down with an Internal Server Error.
    Order allow,deny
    Deny from all
</IfModule>
