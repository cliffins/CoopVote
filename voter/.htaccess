# Keep existing HTML links; never deploy static voter HTML beside these PHP pages.
Options -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([a-z-]+)\.html$ $1.php [END]

<IfModule mod_headers.c>
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header unset ETag
        Header unset Last-Modified
    </FilesMatch>
</IfModule>
FileETag None
