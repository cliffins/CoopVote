# CoopVote — rules for the project root
#
# The folders that hold secrets (config, includes, database, logs) each deny
# everything through their own .htaccess. This file covers the loose files
# that sit in the root and would otherwise be served as plain text.

# ── Files that must never be downloaded ──────────────────────
# composer.lock names the exact version of every library in use, which is
# the first thing an attacker looks for when matching known weaknesses.
# The rest are backups and notes that tend to accumulate beside a project.
# The .bat and .url launchers are meant to be double-clicked from the
# folder, never fetched over HTTP; a batch file offered as a download by a
# web server is a bad habit even when, as here, it holds nothing secret.
<FilesMatch "(?i)\.(sql|cvbak|key|pem|lock|log|ini|bak|old|orig|save|swp|dist|env|sh|md|bat|cmd|ps1|url)$|^(composer\.(json|lock)|\.env.*|\.git.*|.*~)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        # Apache 2.2 syntax — using 2.4 syntax on 2.2 is a fatal error that
        # takes the whole site down with an Internal Server Error.
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── No directory listings anywhere ───────────────────────────
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ── Do not advertise what is running ─────────────────────────
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # Nothing here is meant to be framed by another site, and a voting
    # page inside somebody else's frame is how a member gets tricked into
    # clicking something they cannot see.
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>
<IfModule mod_php.c>
    php_flag expose_php off
</IfModule>

# HTTPS at the origin; forwarded headers from arbitrary clients are not trusted.
# Behind Cloudflare, use Full (strict), never Flexible.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=308,L,NE]
</IfModule>
<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</IfModule>

# Keep page templates and their shared helpers in sync after an update.
# A database import does not clear a browser's cached JavaScript.
<IfModule mod_headers.c>
    <FilesMatch "(^app\.js$|\.html$)">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
